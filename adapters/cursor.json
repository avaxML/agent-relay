{
  "name": "cursor",
  "executable": "cursor-agent",
  "default_model": "grok-4.7-high",
  "args": [
    "-p",
    "--workspace",
    "{provider_workspace}",
    "--mode",
    "ask",
    "--sandbox",
    "enabled",
    "--model",
    "{model}",
    "--output-format",
    "stream-json"
  ],
  "input": "stdin",
  "output": "cursor-jsonl",
  "env": {},
  "models_args": [
    "models"
  ],
  "probe_args": [
    "--help"
  ],
  "tools": {
    "args": [
      "-p",
      "--workspace",
      "{clone}",
      "--trust",
      "--sandbox",
      "enabled",
      "--model",
      "{model}",
      "--output-format",
      "stream-json"
    ],
    "env": {}
  },
  "effort": {
    "models": [
      "grok-4.7-low",
      "grok-4.7-medium",
      "grok-4.7-high",
      "grok-4.7-xhigh"
    ],
    "levels": {
      "low": {
        "model": "grok-4.7-low"
      },
      "medium": {
        "model": "grok-4.7-medium"
      },
      "high": {
        "model": "grok-4.7-high"
      },
      "xhigh": {
        "model": "grok-4.7-xhigh",
        "timeout": 600
      }
    }
  }
}
